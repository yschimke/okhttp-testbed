{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>yschimke/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Keep the JVM test suites on JUnit 5. JUnit 6 requires Java 17+, so it is not a drop-in upgrade here.",
      "matchManagers": [
        "gradle"
      ],
      "matchPackageNames": [
        "org.junit:junit-bom",
        "org.junit.jupiter:{/,}**",
        "org.junit.platform:{/,}**",
        "org.junit.vintage:{/,}**"
      ],
      "allowedVersions": "<6"
    },
    {
      "description": "Move the Docker Compose image and JVM container-test pin together; checkImagePins rejects drift.",
      "matchPackageNames": [
        "ghcr.io/mccutchen/go-httpbin"
      ],
      "groupName": "go-httpbin"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The HTTPBin version catalog entry feeds container tests and must move with the Docker Compose image.",
      "managerFilePatterns": [
        "/^gradle/libs\\.versions\\.toml$/"
      ],
      "matchStrings": [
        "gohttpbin = \"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "ghcr.io/mccutchen/go-httpbin",
      "datasourceTemplate": "docker"
    }
  ]
}
