<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!--
    Force CT for the fixture's application trust anchor. Android 17 defaults CT on for system
    trust anchors, but custom anchors are exempt unless the application explicitly opts in.
  -->
  <domain-config>
    <domain includeSubdomains="false">ct-enforced.test</domain>
    <trust-anchors>
      <certificates src="@raw/ct_fixture_ca" />
    </trust-anchors>
    <certificateTransparency enabled="true" />
  </domain-config>

  <!-- The same certificate must connect when the application uses Android 17's opt-out. -->
  <domain-config>
    <domain includeSubdomains="false">ct-opt-out.test</domain>
    <trust-anchors>
      <certificates src="@raw/ct_fixture_ca" />
    </trust-anchors>
    <certificateTransparency enabled="false" />
  </domain-config>
</network-security-config>
